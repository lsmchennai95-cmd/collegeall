# ==============================================================================
# CollegeAll Environment Configuration
# ==============================================================================
# Supported environments: 'local', 'production'
APP_ENV=local

# Application Base URL
# Local: http://localhost:8001
# Production: https://collegeall.com
APP_URL=http://localhost:8001

# Asset Base URL (CSS, JS, Images, Fonts)
# Local: http://localhost:8001
# Production: https://collegeall.com
ASSET_BASE_URL=http://localhost:8001

# API Base URL (Configurable independently for staging, local mock, or prod API)
# Default: https://api.collegeall.com
API_BASE_URL=https://api.collegeall.com
